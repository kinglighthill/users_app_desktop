<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import org.controlsfx.control.GridView?>
<?import javafx.scene.image.ImageView?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.scholarly.utme.controller.AppsGridScreenController"
            prefHeight="400.0" prefWidth="600.0">

    <top>
        <VBox>
            <HBox spacing="10" prefHeight="60" alignment="CENTER_LEFT" style="-fx-background-color: white;">
                <Button fx:id="backButton" maxHeight="30" maxWidth="30" style="-fx-cursor: hand;"/>
                <Label fx:id="appsTitle" text="Mobile Apps" textFill="#053500">
                    <font>
                        <Font name="Gill Sans MT Bold" size="24"/>
                    </font>
                </Label>
                <padding>
                    <Insets left="30"/>
                </padding>
            </HBox>
        </VBox>
    </top>

    <center>
        <AnchorPane style="-fx-background-color: white;">
            <StackPane alignment="CENTER_LEFT" AnchorPane.leftAnchor="40" AnchorPane.topAnchor="20">
                <TextField fx:id="searchTextField" prefHeight="40" minWidth="300" promptText="Enter a keyword" style="-fx-border-radius: 10;">
                    <font>
                        <Font size="15"/>
                    </font>
                </TextField>
                <ImageView fx:id="searchIcon" preserveRatio="true" pickOnBounds="true" StackPane.alignment="CENTER_RIGHT">
                    <StackPane.margin>
                        <Insets right="20"/>
                    </StackPane.margin>
                </ImageView>
            </StackPane>

            <StackPane AnchorPane.leftAnchor="30" AnchorPane.topAnchor="70" AnchorPane.rightAnchor="30" AnchorPane.bottomAnchor="20">
                <TilePane fx:id="appsTilePane" prefHeight="50" maxHeight="50" hgap="15" vgap="15" StackPane.alignment="TOP_LEFT">
                    <padding>
                        <Insets top="10" left="15"/>
                    </padding>
                </TilePane>

                <HBox fx:id="noApplicationHBox" alignment="CENTER" visible="false" StackPane.alignment="TOP_CENTER">
                    <VBox spacing="15" alignment="CENTER">
                        <ImageView fx:id="noAppsImage" fitHeight="220" fitWidth="220"/>
                        <Label text="Oops...No Item Available at the moment. Please check your Internet Connection and Try Again">
                            <font>
                                <Font size="20"/>
                            </font>
                        </Label>
                    </VBox>
                </HBox>
            </StackPane>
        </AnchorPane>
    </center>

</BorderPane>
