<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.scholarly.utme.controller.NovelChapterListController"
            prefHeight="400.0" prefWidth="600.0">

    <top>
        <VBox>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Button fx:id="backButton" style="-fx-background-color: #E7F7E9"/>
                <Label fx:id="pageTitle" text="JAMB Prose" textFill="#034801">
                    <font>
                        <Font name="System Bold" size="20"/>
                    </font>
                </Label>
                <padding>
                    <Insets top="20" left="20" bottom="20"/>
                </padding>
            </HBox>
            <Separator />
        </VBox>
    </top>

    <center>
        <HBox>
            <VBox>
                <Label text="Chapters" />
                <ListView fx:id="chaptersList" />
            </VBox>
            <Separator/>
        </HBox>
    </center>

    <right>
        <HBox spacing="20">

            <VBox spacing="20" prefHeight="600" prefWidth="300">
                <ImageView fx:id="novelImage" fitWidth="180" fitHeight="230" preserveRatio="true" pickOnBounds="true"/>
                <Label fx:id="novelDescription" prefHeight="180" wrapText="true"/>
                <Separator/>
                <HBox spacing="10">
                    <ImageView fx:id="authorIcon" preserveRatio="true" pickOnBounds="true"/>
                    <Label fx:id="authorLabel" text="John Uzodinma"/>
                </HBox>
                <HBox spacing="10">
                    <ImageView fx:id="chaptersIcon" preserveRatio="true" pickOnBounds="true"/>
                    <Label fx:id="chaptersLabel" text="7 chapters"/>
                </HBox>
                <HBox spacing="10">
                    <ImageView fx:id="timeIcon" preserveRatio="true" pickOnBounds="true"/>
                    <Label fx:id="timeText" text="20 mins"/>
                </HBox>

                <Button fx:id="readButton" text="Read" textFill="white" prefWidth="110" prefHeight="30" style="-fx-background-color: #12AF20; -fx-background-radius: 5;"/>
            </VBox>

            <padding>
                <Insets right="20"/>
            </padding>
        </HBox>
    </right>

</BorderPane>
