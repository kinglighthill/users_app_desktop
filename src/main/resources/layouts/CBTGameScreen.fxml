<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="800.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.scholarly.utme.controller.CBTGameScreenController">
   <top>
      <ToolBar prefHeight="84.0" prefWidth="1000.0" style="-fx-background-color: #105801;" BorderPane.alignment="CENTER">
        <items>
          <Button fx:id="backButton" mnemonicParsing="false" />
            <Label fx:id="pageTitle" text="CBT Game" textFill="WHITE">
               <padding>
                  <Insets left="20.0" />
               </padding>
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
        </items>
         <padding>
            <Insets left="10.0" />
         </padding>
      </ToolBar>
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="9.0" prefWidth="600.0">
               <children>
                  <Label fx:id="questionNumberLabel" text="Question 1 of 2">
                     <HBox.margin>
                        <Insets left="10.0" />
                     </HBox.margin>
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <ImageView fx:id="bookmarkImage" fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                     <HBox.margin>
                        <Insets left="35.0" right="30.0" />
                     </HBox.margin>
                  </ImageView>
                  <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                  <Button fx:id="fiftyFiftyButton" mnemonicParsing="false" style="-fx-background-color: #E6F4E3; -fx-background-radius: 500; -fx-border-color: #1B9D01; -fx-border-radius: 500; -fx-border-width: 1;" text="50:50" textFill="#1b9d01">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin></Button>
                  <Label fx:id="fiftyFiftyCount" text="0">
                     <HBox.margin>
                        <Insets right="40.0" />
                     </HBox.margin>
                  </Label>
                  <ImageView fx:id="calculatorImage" fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                     <HBox.margin>
                        <Insets right="40.0" />
                     </HBox.margin>
                  </ImageView>
               </children>
               <padding>
                  <Insets bottom="30.0" top="30.0" />
               </padding>
            </HBox>
            <Separator prefWidth="200.0">
               <VBox.margin>
                  <Insets left="10.0" />
               </VBox.margin></Separator>
            <HBox fx:id="questionLayout" prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="questionLabel" text="Simplify 0.000215 x 0.000028 and Express your answer in standard form" textAlignment="CENTER" textFill="#178102" wrapText="true" VBox.vgrow="ALWAYS">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </Label>
                     </children>
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                     <padding>
                        <Insets left="40.0" right="40.0" />
                     </padding>
                  </VBox>
                  <Separator orientation="VERTICAL" prefHeight="200.0" />
                  <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Button fx:id="optionAButton" mnemonicParsing="false" prefHeight="140.0" prefWidth="60000.0" style="-fx-background-color: #0000ff; -fx-border-radius: 34; -fx-border-width: 2; -fx-border-color: #00ffffff;" text="Button">
                           <VBox.margin>
                              <Insets left="60.0" right="40.0" />
                           </VBox.margin>
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Button>

                        <Button fx:id="optionBButton" mnemonicParsing="false" prefHeight="140.0" prefWidth="800000.0" text="Button">
                           <VBox.margin>
                              <Insets left="60.0" right="40.0" top="20.0" />
                           </VBox.margin>
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Button>

                        <Button fx:id="optionCButton" mnemonicParsing="false" prefHeight="140.0" prefWidth="800000.0" text="Button">
                           <VBox.margin>
                              <Insets left="60.0" right="40.0" top="20.0" />
                           </VBox.margin>
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Button>

                        <Button fx:id="optionDButton" mnemonicParsing="false" prefHeight="140.0" prefWidth="800000.0" text="Button">
                           <VBox.margin>
                              <Insets left="60.0" right="40.0" top="20.0" />
                           </VBox.margin>
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Button>
                     </children>
                     <padding>
                        <Insets bottom="40.0" top="40.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
