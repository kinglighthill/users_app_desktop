<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.bootstrapfx.scene.layout.Panel?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.scholarly.utme.controller.landing_screen.LandingScreenTriviaController" prefHeight="800.0" prefWidth="1000.0">

    <top>
        <HBox prefHeight="70" style="-fx-background-color:white;"/>
    </top>

    <center>
        <Panel prefHeight="300" style="-fx-background-color: #F4FFF5; -fx-background-radius: 5;">
            <left>
                <VBox spacing="25" prefWidth="600" alignment="CENTER_LEFT">
                    <Label fx:id="challengeHeader" prefWidth="500" text="Welcome to Scholarly Trivia Challenge" textFill="#053500" wrapText="true"/>
                    <Label fx:id="challengeDescription" prefWidth="400" text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Id vitae faucibus sit malesuada donec vel mi, vitae. " textFill="#053500" wrapText="true"/>
                    <VBox spacing="10" maxWidth="350">
                        <TextField fx:id="usernameField" promptText="Enter username" style="-fx-border-color: rgba(18, 175, 32, 0.5); -fx-border-radius: 8;">
                            <padding>
                                <Insets top="7" bottom="7"/>
                            </padding>
                        </TextField>
                        <Label fx:id="usernameError" text="Username is taken. Try this username Uche007" textFill="#FF0000" wrapText="true"/>

                    </VBox>
                    <Button fx:id="startButton" prefWidth="350" text="Start" textFill="white" style="-fx-background-color: #12AF20; -fx-background-radius: 5;">
                        <padding>
                            <Insets top="8" bottom="8"/>
                        </padding>
                    </Button>
                    <padding>
                        <Insets bottom="20" top="10"/>
                    </padding>
                </VBox>
            </left>
            <right>
                <ImageView fx:id="centerImage" fitHeight="400" fitWidth="400" preserveRatio="true" pickOnBounds="true"/>
            </right>
            <padding>
                <Insets left="40"/>
            </padding>
        </Panel>
