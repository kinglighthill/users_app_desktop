<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.bootstrapfx.scene.layout.Panel?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.scholarly.utme.controller.landing_screen.LandingScreenTriviaController" prefHeight="800.0" prefWidth="1000.0">

    <top>
        <HBox prefHeight="70" style="-fx-background-color:white;"/>
    </top>

    <center>
        <Panel prefHeight="300" style="-fx-background-color: #F4FFF5; -fx-background-radius: 5;">
            <left>
                <VBox spacing="25" prefWidth="600" alignment="CENTER_LEFT">
                    <Label fx:id="challengeHeader" prefWidth="500" text="Welcome to Scholarly Trivia Challenge" textFill="#053500" wrapText="true"/>
                    <Label fx:id="challengeDescription" prefWidth="400" text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Id vitae faucibus sit malesuada donec vel mi, vitae. " textFill="#053500" wrapText="true"/>
                    <VBox spacing="10" maxWidth="350">
                        <TextField fx:id="usernameField" promptText="Enter username" style="-fx-border-color: rgba(18, 175, 32, 0.5); -fx-border-radius: 8;">
                            <padding>
                                <Insets top="7" bottom="7"/>
                            </padding>
                        </TextField>
                        <Label fx:id="usernameError" text="Username is taken. Try this username Uche007" textFill="#FF0000" wrapText="true"/>

                    </VBox>
                    <Button fx:id="startButton" prefWidth="350" text="Start" textFill="white" style="-fx-background-color: #12AF20; -fx-background-radius: 5;">
                        <padding>
                            <Insets top="8" bottom="8"/>
                        </padding>
                    </Button>
                    <padding>
                        <Insets bottom="20" top="10"/>
                    </padding>
                </VBox>
            </left>
            <right>
                <ImageView fx:id="centerImage" fitHeight="400" fitWidth="400" preserveRatio="true" pickOnBounds="true"/>
            </right>
            <padding>
                <Insets left="40"/>
            </padding>
        </Panel>

    </center>

    <bottom>
        <VBox spacing="20" prefHeight="300">
            <Label fx:id="prevHeader" text="Previous Challenges" textFill="#053500"/>
            <HBox spacing="15">
                <Panel fx:id="prevChallenge1" style="-fx-border-color: rgba(207, 207, 207, 0.2); -fx-border-radius: 7; ">
                    <left>
                        <ImageView fx:id="prevChallengeIcon1" fitWidth="50" fitHeight="50"/>
                    </left>
                    <right>
                        <VBox spacing="5">
                            <Label text="Topic: Integration">
                                <font>
                                    <Font name="Gill Sans MT" size="20"/>
                                </font>
                            </Label>
                            <Label text="Integral Transforms">
                                <font>
                                    <Font name="Gill Sans MT" size="16"/>
                                </font>
                            </Label>
                            <HBox spacing="10">
                                <Label text="300 Participants">
                                    <font>
                                        <Font name="Gill Sans MT" size="14"/>
                                    </font>
                                </Label>
                                <Separator orientation="VERTICAL"/>
                                <Label text="Score: 50%" textFill="#12AF20"/>
                                <VBox.margin>
                                    <Insets top="8"/>
                                </VBox.margin>
                            </HBox>
                            <HBox spacing="15" alignment="CENTER_LEFT">
                                <ImageView fx:id="playerImage1" fitHeight="35" fitWidth="35"/>
                                <VBox alignment="CENTER_LEFT">
                                    <Label text="Created by">
                                        <font>
                                            <Font name="Gill Sans MT" size="13"/>
                                        </font>
                                    </Label>
                                    <Label text="Zuri Nzube">
                                        <font>
                                            <Font name="Gill Sans MT" size="14"/>
                                        </font>
                                    </Label>
                                </VBox>
                                <VBox.margin>
                                    <Insets top="8"/>
                                </VBox.margin>
                            </HBox>
                            <padding>
                                <Insets left="20"/>
                            </padding>
                        </VBox>
                    </right>

                    <padding>
                        <Insets top="15" right="30" bottom="15" left="15"/>
                    </padding>
                </Panel>

                <Panel fx:id="prevChallenge2" style="-fx-border-color: rgba(207, 207, 207, 0.2); -fx-border-radius: 7;">
