                            </HBox>
                            <padding>
                                <Insets left="20"/>
                            </padding>
                        </VBox>
                    </right>

                    <padding>
                        <Insets top="15" right="30" bottom="15" left="15"/>
                    </padding>
                </Panel>

                <Panel fx:id="prevChallenge3" style="-fx-border-color: rgba(207, 207, 207, 0.2); -fx-border-radius: 7;">
                    <left>
                        <ImageView fx:id="prevChallengeIcon3" fitWidth="50" fitHeight="50"/>
                    </left>
                    <right>
                        <VBox spacing="5">
                            <Label text="Topic: Integration">
                                <font>
                                    <Font name="Gill Sans MT" size="20"/>
                                </font>
                            </Label>
                            <Label text="Integral Transforms">
                                <font>
                                    <Font name="Gill Sans MT" size="16"/>
                                </font>
                            </Label>
                            <HBox spacing="10">
                                <Label text="300 Participants">
