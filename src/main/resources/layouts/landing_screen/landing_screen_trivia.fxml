    </center>

    <bottom>
        <VBox prefHeight="300" >
            <Label fx:id="prevHeader" text="Previous Challenges" textFill="#053500"/>

            <padding>
                <Insets top="30"/>
            </padding>
        </VBox>
    </bottom>

    <padding>
        <Insets left="50" right="70"/>
    </padding>

