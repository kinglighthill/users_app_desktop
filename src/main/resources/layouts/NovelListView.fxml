<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import org.kordamp.bootstrapfx.scene.layout.Panel?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.scholarly.utme.controller.NovelListViewController"
            prefHeight="400.0" prefWidth="600.0">

    <center>
        <VBox fx:id="centerBox" spacing="30" prefWidth="500">
            <VBox spacing="15" prefWidth="500" style="-fx-background-color: #F4FFF5; -fx-background-radius: 5;">
                <Label fx:id="infoText" text="NOTE: These books listed below represent both the new and old recommended literary texts. You are expected to study texts relevant to JAMB 2021 according to the JAMB syllabus" textFill="#053500" wrapText="true"/>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <RadioButton fx:id="dontShowButton" text="Don't show again" textFill="#053500"/>
                    <Button fx:id="dismissButton" text="Dismiss" textFill="white" style="-fx-background-color: #12AF20;"/>
                </HBox>
                <padding>
                    <Insets topRightBottomLeft="15"/>
                </padding>
            </VBox>
            <Panel>
                <left>
                    <Label fx:id="proseText" text="JAMB Prose"/>
                </left>
                <right>
                    <Button fx:id="viewAllButton" text="View all" textFill="#12AF20" style="-fx-border-color: #12AF20; -fx-border-radius: 5;">
                        <padding>
                            <Insets left="10" right="10" top="5" bottom="5"/>
                        </padding>
                    </Button>
                </right>
                <bottom>
                    <ListView fx:id="jambNovelsList" orientation="HORIZONTAL" prefHeight="250">
                        <padding>
                            <Insets top="15"/>
                        </padding>
                    </ListView>
                </bottom>
            </Panel>
            <padding>
                <Insets top="20" left="18" bottom="20" right="20"/>
            </padding>
        </VBox>
    </center>
    <right>
        <HBox spacing="20">
            <Separator orientation="VERTICAL"/>
            <VBox prefWidth="300">

            </VBox>
            <padding>
                <Insets top="20" bottom="20" right="20"/>
            </padding>
        </HBox>
    </right>
</BorderPane>
