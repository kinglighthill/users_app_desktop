<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<fx:root type="org.controlsfx.control.GridCell" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">

    <graphic>
        <VBox spacing="15" alignment="CENTER_LEFT" prefHeight="300" prefWidth="200" style="-fx-border-color: #F4FFF5; -fx-border-radius: 5;">
            <ImageView fx:id="updateImage" fitWidth="200" fitHeight="120" preserveRatio="true" pickOnBounds="true"/>
            <Label fx:id="updateTitle" text="JAMB Register resigns in office" textFill="#053500" wrapText="true"/>
            <Label fx:id="updateDate" text="6th Sept, 2021" textFill="#12AF20"/>
            <Label fx:id="updateDetails" prefHeight="50" text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Id vitae faucibus sit  vitae " textFill="#053500" wrapText="true"/>
            <padding>
                <Insets topRightBottomLeft="15"/>
            </padding>
        </VBox>
    </graphic>
</fx:root>
