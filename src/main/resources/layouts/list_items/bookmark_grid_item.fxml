<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<fx:root type="org.controlsfx.control.GridCell" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <graphic>
        <HBox spacing="15" prefWidth="300" prefHeight="150" style="-fx-background-color: white; -fx-border-color: #F1F1F1; -fx-border-radius: 8;">
            <ImageView fx:id="bookmarkImage" preserveRatio="true" pickOnBounds="true"/>
            <VBox spacing="15">
                <Label fx:id="bookmarkTitle" text="CBT Practice Test" textFill="#053500"/>
                <Label fx:id="bookmarkedItem" text="Question 5" textFill="#053500"/>
                <Label fx:id="bookmarkCategory" text="CBT Practice" textFill="#12AF20"/>
            </VBox>
        </HBox>
    </graphic>
</fx:root>
