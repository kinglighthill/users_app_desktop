<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<fx:root type="org.controlsfx.control.GridCell" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">

    <graphic>
        <VBox spacing="20" alignment="CENTER" maxWidth="180" minWidth="180" minHeight="180" maxHeight="180" style="-fx-border-color: #F1F1F1; -fx-border-radius: 5;">
            <ImageView fx:id="appImage" fitWidth="120" fitHeight="120" preserveRatio="true" pickOnBounds="true"/>
            <HBox alignment="CENTER">
                <Label fx:id="appName" wrapText="true" prefWidth="150" alignment="CENTER" textAlignment="CENTER"/>
            </HBox>
            <padding>
                <Insets topRightBottomLeft="15"/>
            </padding>
        </VBox>
    </graphic>
</fx:root>
