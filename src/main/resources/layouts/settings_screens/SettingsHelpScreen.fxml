<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.bootstrapfx.scene.layout.Panel?>
<?import javafx.scene.image.ImageView?>
<?import com.scholarly.ui.utils.CustomTitledPane?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.scholarly.controller.settings_screens.SettingsHelpScreenController"
            prefHeight="400.0" prefWidth="600.0">

    <top>
        <HBox spacing="10" prefHeight="60" alignment="CENTER_LEFT" style="-fx-background-color: white;">
            <Button fx:id="backButton" maxHeight="30" maxWidth="30" style="-fx-cursor: hand;"/>
            <Label text="Help" textFill="#053500">
                <font>
                    <Font name="Gill Sans MT Bold" size="24"/>
                </font>
            </Label>
            <padding>
                <Insets left="30"/>
            </padding>
        </HBox>
    </top>

    <center>
        <AnchorPane style="-fx-background-color: white;">
            <ScrollPane fitToWidth="true" style="-fx-background-color: white;"
                        AnchorPane.leftAnchor="50" AnchorPane.topAnchor="30" AnchorPane.rightAnchor="300"  AnchorPane.bottomAnchor="150">
                <VBox spacing="15">
                    <VBox fx:id="faqVBox" spacing="15">
                        <Panel fx:id="faqPanel" style="-fx-background-color: rgba(18, 175, 32, 0.2); -fx-cursor: hand;">
                            <left>
                                <HBox spacing="30" alignment="CENTER">
                                    <ImageView fx:id="faqImage" preserveRatio="true" pickOnBounds="true"/>
                                    <Label text="Frequently Asked Questions (FAQ)" textFill="#053500">
                                        <font>
                                            <Font size="16"/>
                                        </font>
                                    </Label>
                                </HBox>
                            </left>
                            <right>
                                <ToggleButton fx:id="faqDropdown"/>
                            </right>
                            <padding>
                                <Insets top="20" bottom="20" left="30" right="30"/>
                            </padding>
                        </Panel>
                        <VBox fx:id="faqDetails" spacing="10"/>
                    </VBox>

                    <VBox fx:id="contactVBox" spacing="10">
                        <Panel fx:id="contactPanel" style="-fx-background-color: rgba(18, 175, 32, 0.2); -fx-cursor: hand;">
                            <left>
                                <HBox spacing="30" alignment="CENTER">
                                    <ImageView fx:id="contactImage" preserveRatio="true" pickOnBounds="true"/>
                                    <Label text="Contact Us" textFill="#053500">
                                        <font>
                                            <Font size="16"/>
                                        </font>
                                    </Label>
                                </HBox>
                            </left>
                            <right>
                                <ToggleButton fx:id="contactDropdown"/>
                            </right>
                            <padding>
                                <Insets top="20" bottom="20" left="30" right="30"/>
                            </padding>
                        </Panel>
                        <VBox fx:id="contactDetails" spacing="10">
                            <HBox spacing="30" alignment="CENTER_LEFT" style="-fx-background-color: rgba(18, 175, 32, 0.1); -fx-background-radius: 5; -fx-cursor: hand;">
                                <ImageView fx:id="phoneImage" preserveRatio="true" pickOnBounds="true"/>
                                <Label text="+234 816 734 8170" textFill="#053500">
                                    <font>
                                        <Font size="16"/>
                                    </font>
                                </Label>
                                <padding>
                                    <Insets top="20" bottom="20" left="30" right="30"/>
                                </padding>
                            </HBox>

                            <HBox fx:id="whatsAppPane" spacing="30" alignment="CENTER_LEFT" style="-fx-background-color: rgba(18, 175, 32, 0.1); -fx-background-radius: 5; -fx-cursor: hand;">
                                <ImageView fx:id="whatsAppImage" preserveRatio="true" pickOnBounds="true"/>
                                <Label text="+234 813 694 1462" textFill="#053500">
                                    <font>
                                        <Font size="16"/>
                                    </font>
                                </Label>
                                <padding>
                                    <Insets top="20" bottom="20" left="30" right="30"/>
                                </padding>
                            </HBox>

                            <HBox fx:id="gmailPane" spacing="30" alignment="CENTER_LEFT" style="-fx-background-color: rgba(18, 175, 32, 0.1); -fx-background-radius: 5; -fx-cursor: hand;">
                                <ImageView fx:id="mailImage" preserveRatio="true" pickOnBounds="true"/>
                                <Label text="info@scholarly.africa" textFill="#053500">
                                    <font>
                                        <Font size="16"/>
                                    </font>
                                </Label>
                                <padding>
                                    <Insets top="20" bottom="20" left="30" right="30"/>
                                </padding>
                            </HBox>

                            <HBox fx:id="websitePane" spacing="30" alignment="CENTER_LEFT" style="-fx-background-color: rgba(18, 175, 32, 0.1); -fx-cursor: hand;">
                                <ImageView fx:id="websiteImage" preserveRatio="true" pickOnBounds="true"/>
                                <Label text="www.scholarly.africa" textFill="#053500">
                                    <font>
                                        <Font size="16"/>
                                    </font>
                                </Label>
                                <padding>
                                    <Insets top="20" bottom="20" left="30" right="30"/>
                                </padding>
                            </HBox>
                            <padding>
                                <Insets left="20" right="20"/>
                            </padding>
                        </VBox>
                    </VBox>

                </VBox>
                <padding>
                    <Insets right="15"/>
                </padding>
            </ScrollPane>

            <HBox alignment="TOP_CENTER" AnchorPane.leftAnchor="50" AnchorPane.rightAnchor="300" AnchorPane.bottomAnchor="30">
                <VBox spacing="25">
                    <Label text="You can also reach us via our social handles">
                        <font>
                            <Font size="18"/>
                        </font>
                    </Label>

                    <HBox spacing="20" alignment="TOP_CENTER">
                        <ImageView fx:id="linkedInImage" preserveRatio="true" pickOnBounds="true" style="-fx-cursor: hand;"/>
                        <ImageView fx:id="facebookImage" preserveRatio="true" pickOnBounds="true" style="-fx-cursor: hand;"/>
                        <ImageView fx:id="twitterImage" preserveRatio="true" pickOnBounds="true" style="-fx-cursor: hand;"/>
                        <ImageView fx:id="instagramImage" preserveRatio="true" pickOnBounds="true" style="-fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </HBox>
        </AnchorPane>
    </center>

</BorderPane>
