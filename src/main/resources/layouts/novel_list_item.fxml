<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<fx:root type="javafx.scene.control.ListCell" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" >
    <graphic>
        <VBox fx:id="novelBox" spacing="10" alignment="CENTER" style="-fx-border-color: #12AF20; -fx-border-radius: 10;">
            <ImageView fx:id="novelImage"/>
            <VBox>
                <Label fx:id="name"/>
                <Label fx:id="chapters"/>
                <padding>
                    <Insets left="5"/>
                </padding>
            </VBox>

            <padding>
                <Insets left="6" right="6"/>
            </padding>
        </VBox>
    </graphic>

</fx:root>
