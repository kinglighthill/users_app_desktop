                    <VBox fx:id="noAccountVBox" spacing="20" prefWidth="400" style="-fx-background-color: white; -fx-background-radius: 7; -fx-border-color: #F1F1F1; -fx-border-radius: 7; -fx-cursor: hand;">
                        <children>
                            <Panel fx:id="noAccountPanel" prefHeight="60">
                                <left>
                                    <HBox spacing="30" alignment="CENTER">
                                        <ImageView fx:id="noAccountImage" preserveRatio="true" pickOnBounds="true"/>
                                        <Label text="I don't have an account">
                                            <font>
                                                <Font size="16"/>
                                            </font>
                                        </Label>
                                        <HBox.margin>
                                            <Insets left="15"/>
                                        </HBox.margin>
                                    </HBox>
                                </left>
                                <right>
                                    <HBox alignment="CENTER">
                                        <ToggleButton fx:id="noAccountDropdown"/>
                                        <HBox.margin>
                                            <Insets left="15"/>
                                        </HBox.margin>
                                    </HBox>
                                </right>
                            </Panel>
                            <VBox fx:id="noAccountDetailsPane" spacing="25">
                                <Separator/>
                                <Label text="For those who cannot make payment because they do not have a bank account, you can do any of the following:" wrapText="true">
                                    <font>
                                        <Font size="14"/>
                                    </font>
                                </Label>

                                <Label text="1. Go to any POS Agent in your area, give them cash, provide them with any of our account numbers specified in the first payment option and ask them to do the transfer for you." wrapText="true">
                                    <font>
                                        <Font size="14"/>
                                    </font>
                                </Label>

                                <Label text="2. Ask people who have accounts around you. You can ask from parents, friends or relatives to help you make the transfer to any of our account numbers." wrapText="true">
                                    <font>
                                        <Font size="14"/>
                                    </font>
                                </Label>

                                <Label text="After they make payment, you will be required to send the details of payment on WhatsApp to +2348136941462">
                                    <font>
                                        <Font size="14"/>
                                    </font>
                                </Label>

                                <Label text="Details to be sent includes:">
                                    <font>
                                        <Font size="14"/>
                                    </font>
                                </Label>

                                <VBox spacing="10">
                                    <Label text="1. Sender account name">
                                        <font>
                                            <Font size="14"/>
                                        </font>
                                    </Label>
                                    <Label text="2. Amount paid">
                                        <font>
                                            <Font size="14"/>
                                        </font>
                                    </Label>
                                    <Label text="3. Date and Time of Payment">
                                        <font>
                                            <Font size="14"/>
                                        </font>
                                    </Label>
                                    <Label text="4. Bank paid to">
                                        <font>
                                            <Font size="14"/>
                                        </font>
                                    </Label>
                                    <Label text="5. Exam/app paid for (e.g. JAMB, WAEC, Post UTME etc)">
                                        <font>
                                            <Font size="14"/>
                                        </font>
                                    </Label>
                                    <Label text="6. Device to activate: Desktop or Android">
                                        <font>
                                            <Font size="14"/>
                                        </font>
                                    </Label>
                                    <Label text="7. Picture or screenshot of your payment receipt or debit alert">
                                        <font>
                                            <Font size="14"/>
                                        </font>
                                    </Label>
                                </VBox>

                                <Label text="Once your payment is confirmed, we will send the activation pin to your email">
                                    <font>
                                        <Font size="14"/>
                                    </font>
                                </Label>
                            </VBox>
                        </children>
                        <padding>
                            <Insets topRightBottomLeft="15"/>
                        </padding>
                    </VBox>

                </VBox>
            </ScrollPane>
        </AnchorPane>
    </center>

    <right>
        <AnchorPane prefWidth="400" prefHeight="400" style="-fx-background-color: white;">
            <HBox alignment="CENTER" style="-fx-background-color: #F4FFF5; -fx-background-radius: 5;"
                  AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.bottomAnchor="20">
                <VBox spacing="40" alignment="TOP_CENTER">
                    <Label fx:id="customerSupportLabel" text="Customer support" textFill="#053500"/>
                    <ImageView fx:id="customerSupportImage" preserveRatio="true" pickOnBounds="true"/>
                    <VBox spacing="10">
                        <HBox spacing="5" alignment="CENTER">
                            <Label text="Need help? Chat us on WhatsApp" textFill="#053500">
                                <font>
                                    <Font size="15"/>
                                </font>
                            </Label>
                            <Label fx:id="chatUsLabel" text="+2348136941462" textFill="#12AF20" style="-fx-cursor: hand;">
                                <font>
                                    <Font size="15"/>
                                </font>
                            </Label>
                        </HBox>
                        <Label text="For customer support or bulk purchase of activation pins call +2348136941462" textAlignment="CENTER" wrapText="true">
                            <font>
                                <Font size="15"/>
                            </font>
                            <padding>
                                <Insets left="15" right="15"/>
                            </padding>
                        </Label>
                    </VBox>
                    <HBox.margin>
                        <Insets top="40"/>
                    </HBox.margin>
                </VBox>
            </HBox>
        </AnchorPane>
    </right>

</BorderPane>
