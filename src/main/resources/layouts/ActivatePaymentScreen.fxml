<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.scholarly.utme.controller.ActivatePaymentScreenController"
            prefHeight="400.0" prefWidth="600.0">

    <top>
        <VBox>
            <HBox spacing="10" prefHeight="60" alignment="CENTER_LEFT" style="-fx-background-color: white;">
                <Button fx:id="backButton" maxHeight="30" maxWidth="30" style="-fx-cursor: hand;"/>
                <Label text="Activate" textFill="#053500">
                    <font>
                        <Font name="Gill Sans MT Bold" size="24"/>
                    </font>
                </Label>
                <padding>
                    <Insets left="30"/>
                </padding>
            </HBox>
            <Separator/>
        </VBox>
    </top>

    <center>
        <AnchorPane prefWidth="500" prefHeight="400" style="-fx-background-color: white;">
            <Label fx:id="paymentMethodText" text="Choose a payment method" AnchorPane.rightAnchor="30" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="30">
                <font>
                    <Font size="16"/>
                </font>
            </Label>
            <ScrollPane fx:id="centerScrollPane" fitToWidth="true" AnchorPane.rightAnchor="30" AnchorPane.topAnchor="60" AnchorPane.leftAnchor="30" AnchorPane.bottomAnchor="20">
                <VBox spacing="10">
                    <VBox fx:id="bankTransferVBox" spacing="20" prefWidth="400" style="-fx-background-color: white; -fx-background-radius: 7; -fx-border-color: #F1F1F1; -fx-border-radius: 7; -fx-cursor: hand;">
                        <children>
                            <Panel fx:id="bankTransferPanel" prefHeight="60">
                                <left>
                                    <HBox spacing="30" alignment="CENTER">
                                        <ImageView fx:id="bankImage" preserveRatio="true" pickOnBounds="true"/>
                                        <Label text="Bank deposit or transfer">
                                            <font>
                                                <Font size="16"/>
                                            </font>
                                        </Label>
                                        <HBox.margin>
                                            <Insets left="15"/>
                                        </HBox.margin>
                                    </HBox>
                                </left>
                                <right>
                                    <HBox alignment="CENTER">
                                        <ToggleButton fx:id="bankTransferDropdown"/>
                                        <HBox.margin>
                                            <Insets right="15"/>
                                        </HBox.margin>
                                    </HBox>
                                </right>
                            </Panel>
                            <VBox fx:id="bankTransferDetailsPane" spacing="25">
                                <Separator/>
                                <Label text="Use your mobile banking app or USSD code to make a transfer of N2000 into any of the bank accounts below:" wrapText="true">
                                    <font>
                                        <Font size="14"/>
                                    </font>
                                </Label>

                                <HBox alignment="CENTER">
                                    <VBox spacing="15">
                                        <StackPane fx:id="paymentImagePane">
                                            <ImageView fx:id="ubaPaymentImage" preserveRatio="true" pickOnBounds="true"/>
                                            <ImageView fx:id="accessPaymentImage" preserveRatio="true" pickOnBounds="true" visible="false"/>
                                            <ImageView fx:id="zenithPaymentImage" preserveRatio="true" pickOnBounds="true" visible="false"/>
                                        </StackPane>
                                        <HBox fx:id="currentPositionHBox" spacing="5" alignment="CENTER">
                                            <Line startX="-10" endX="10" strokeWidth="2.5" stroke="#12AF20"/>
                                            <Line startX="-10" endX="10" strokeWidth="2.5" stroke="#DFDFDF"/>
                                            <Line startX="-10" endX="10" strokeWidth="2.5" stroke="#DFDFDF"/>
                                        </HBox>
                                    </VBox>
                                </HBox>

                                <Label text="After payment send a WhatsApp message to the number +2348136941462 using the format below:" wrapText="true">
                                    <font>
                                        <Font size="14"/>
                                    </font>
                                </Label>

                                <VBox spacing="10">
                                    <Label text="1. Sender account name">
                                        <font>
                                            <Font size="14"/>
                                        </font>
                                    </Label>
                                    <Label text="2. Amount paid">
                                        <font>
                                            <Font size="14"/>
                                        </font>
                                    </Label>
                                    <Label text="3. Date and Time of Payment">
                                        <font>
                                            <Font size="14"/>
                                        </font>
                                    </Label>
                                    <Label text="4. Bank paid to">
                                        <font>
                                            <Font size="14"/>
                                        </font>
                                    </Label>
                                    <Label text="5. Exam/app paid for (e.g. JAMB, WAEC, Post UTME etc)">
                                        <font>
                                            <Font size="14"/>
                                        </font>
                                    </Label>
                                    <Label text="6. Device to activate: Desktop or Android">
                                        <font>
                                            <Font size="14"/>
                                        </font>
                                    </Label>
                                    <Label text="7. Picture or screenshot of your payment receipt or debit alert">
                                        <font>
                                            <Font size="14"/>
                                        </font>
                                    </Label>
                                </VBox>

                                <Label text="Once payment has been confirmed, an activation pin will be instantly sent to your inbox">
                                    <font>
                                        <Font size="14"/>
                                    </font>
                                </Label>

                                <VBox spacing="30" alignment="CENTER">
                                    <Button fx:id="whatsAppButton" text="Paid already? Send us a WhatsApp message +2348136941462" textFill="white" prefHeight="45" prefWidth="280" style="-fx-background-color: #12AF20; -fx-background-radius: 7">
                                        <font>
                                            <Font size="15"/>
                                        </font>
                                    </Button>

                                    <Label text="Receive activation pin after payment confirmation (may take up to 20 minutes)">
                                        <font>
                                            <Font size="14"/>
                                        </font>
                                    </Label>
                                </VBox>
                            </VBox>
                        </children>
                        <padding>
                            <Insets topRightBottomLeft="15"/>
                        </padding>
                    </VBox>

                    <VBox fx:id="paystackVBox" spacing="20" prefWidth="400" style="-fx-background-color: white; -fx-background-radius: 7; -fx-border-color: #F1F1F1; -fx-border-radius: 7; -fx-cursor: hand;">
                        <children>
                            <Panel fx:id="paystackPanel" prefHeight="60">
                                <left>
                                    <HBox spacing="30" alignment="CENTER">
                                        <ImageView fx:id="paystackImage" preserveRatio="true" pickOnBounds="true"/>
                                        <Label text="Pay online (Paystack)">
                                            <font>
                                                <Font size="16"/>
                                            </font>
                                        </Label>
                                        <HBox.margin>
                                            <Insets left="15"/>
                                        </HBox.margin>
                                    </HBox>
                                </left>
                                <right>
                                    <HBox alignment="CENTER">
                                        <ToggleButton fx:id="paystackDropdown"/>

                                        <HBox.margin>
                                            <Insets left="15"/>
                                        </HBox.margin>
                                    </HBox>
                                </right>
                            </Panel>
                            <VBox fx:id="paystackDetailsPane" spacing="25">
                                <Separator/>
                                <HBox alignment="CENTER">
                                    <Button fx:id="paystackButton" text="Pay with Paystack" textFill="white" prefHeight="40" prefWidth="200" style="-fx-background-color: #10AFD4;">
                                        <font>
                                            <Font size="14"/>
                                        </font>
                                    </Button>
                                </HBox>
                            </VBox>
                        </children>
                        <padding>
                            <Insets topRightBottomLeft="15"/>
                        </padding>
                    </VBox>

                    <!--<VBox fx:id="flutterwaveVBox" spacing="20" prefWidth="400" style="-fx-background-color: white; -fx-background-radius: 7; -fx-border-color: #F1F1F1; -fx-border-radius: 7;">
                        <children>
                            <Panel prefHeight="60">
                                <left>
                                    <HBox spacing="30" alignment="CENTER">
                                        <ImageView fx:id="flutterwaveImage" preserveRatio="true" pickOnBounds="true"/>
                                        <Label text="Pay online (Flutterwave)">
                                            <font>
                                                <Font size="16"/>
                                            </font>
                                        </Label>
