<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import org.controlsfx.control.tableview2.TableView2?>
<?import javafx.scene.control.skin.TableHeaderRow?>
<?import javafx.scene.control.skin.TabPaneSkin.TabHeaderArea?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.scholarly.utme.controller.account_screens.AccountTriviaScreenController"
            prefHeight="400.0" prefWidth="600.0">

    <top>
        <HBox spacing="15" prefHeight="60" alignment="CENTER_LEFT" style="-fx-background-color: white;">
            <Button fx:id="backButton" maxHeight="30" maxWidth="30"/>
            <Label text="Trivia Ranking" textFill="#053500">
                <font>
                    <Font name="Gill Sans MT Bold" size="24"/>
                </font>
            </Label>
            <padding>
                <Insets left="30"/>
            </padding>
        </HBox>
    </top>

    <center>
        <AnchorPane prefWidth="500" prefHeight="400" style="-fx-background-color: white">
            <VBox fx:id="centerVBox" spacing="15" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="30" AnchorPane.bottomAnchor="30">
                <Label text="Ranking Leaderboard" textFill="#053500">
                    <font>
                        <Font size="16"/>
                    </font>
                </Label>
                <TableView fx:id="rankingTable">
                    <columns>
                        <TableColumn id="column" fx:id="rankingColumn" text="Ranking" editable="false"/>
                        <TableColumn fx:id="nameColumn" text="Name"/>
                        <TableColumn fx:id="ratingColumn" text="Rating"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </AnchorPane>
    </center>

    <right>
        <AnchorPane prefWidth="400" prefHeight="400" style="-fx-background-color: white;">
            <VBox spacing="20" alignment="TOP_CENTER" style="-fx-background-color: #F4FFF5; -fx-background-radius: 7;"
                  AnchorPane.rightAnchor="30" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.bottomAnchor="30">
                <Label text="Your Ranking Profile" textFill="#053500">
                    <font>
                        <Font size="20"/>
                    </font>
                    <VBox.margin>
                        <Insets top="30"/>
                    </VBox.margin>
                </Label>
                <ImageView fx:id="profileImage" fitWidth="180" fitHeight="180" preserveRatio="true" pickOnBounds="true"/>
                <Label text="MaryRose Ekeh" textFill="#006B17">
                    <font>
                        <Font size="18"/>
                    </font>
                </Label>
                <Label text="500 pts" textFill="#12AF20">
                    <font>
                        <Font size="26"/>
                    </font>
                </Label>
                <HBox spacing="5" alignment="BOTTOM_CENTER">
                    <Label text="Position:" textFill="#053500">
                        <font>
                            <Font size="18"/>
                        </font>
                    </Label>
                    <Label text="6th" textFill="#053500">
                        <font>
                            <Font size="18"/>
                        </font>
                    </Label>
                    <VBox.margin>
                        <Insets top="30"/>
                    </VBox.margin>
                </HBox>
            </VBox>
        </AnchorPane>
    </right>

</BorderPane>
