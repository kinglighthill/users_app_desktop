<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Line?>
<?import jidefx.scene.control.field.NumberField?>
<?import com.scholarly.utme.ui.utils.CustomNumberField?>
<?import org.controlsfx.control.TaskProgressView?>
<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" prefHeight="800.0" prefWidth="1000.0"
            fx:controller="com.scholarly.utme.controller.AuthenticationController" style="-fx-background-color: #FFFFFF">

    <BorderPane prefWidth="800" prefHeight="600"
                AnchorPane.topAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10">
        <left>
            <StackPane prefWidth="500">
                <ImageView fx:id="imageView" preserveRatio="true" pickOnBounds="true"/>
                <Pane style="-fx-background-color: #000000" opacity="0.5" StackPane.alignment="BOTTOM_CENTER"/>

                <HBox spacing="3" StackPane.alignment="TOP_LEFT">
                    <ImageView fx:id="appIcon" fitWidth="50" fitHeight="50" preserveRatio="true" pickOnBounds="true"/>
                    <Label fx:id="scholarlyText" text="Scholarly" textFill="#FFFFFF">
                        <HBox.margin>
                            <Insets top="5"/>
                        </HBox.margin>
                    </Label>
                    <StackPane.margin>
                        <Insets top="80" left="30"/>
                    </StackPane.margin>
                </HBox>

                <Label fx:id="beTheBestText" text="Be The Best You Can Be. Excel With The Scholarly CBT App." prefWidth="350" textFill="#FFFFFF"  wrapText="true" StackPane.alignment="CENTER_LEFT">
                    <StackPane.margin>
                        <Insets top="170" left="40"/>
                    </StackPane.margin>
                </Label>
                <Line startX="-10" endX="100" stroke="#12AF20" strokeWidth="8" StackPane.alignment="CENTER_LEFT">
                    <StackPane.margin>
                        <Insets top="300" left="40"/>
                    </StackPane.margin>
                </Line>
            </StackPane>
        </left>

        <right>
            <StackPane fx:id="authenticationSection" prefWidth="500" prefHeight="200">
                <VBox fx:id="signUpSection" prefWidth="500" prefHeight="200" alignment="TOP_CENTER" visible="false">
                    <VBox fx:id="signUpNameSection" spacing="10">
                        <Label fx:id="signUpHeaderText" text="Sign up" textFill="#034801"/>
                        <Label fx:id="signUpNameText" text="Full Name">
                            <VBox.margin>
                                <Insets top="30"/>
                            </VBox.margin>
                        </Label>

                        <TextField fx:id="signUpNameField" promptText="Enter your First Name and Last Name" prefWidth="80" style="-fx-background-color: rgba(44, 189, 57, 0.1);">
                            <padding>
                                <Insets left="7" top="10" bottom="10"/>
                            </padding>
                        </TextField>

                    </VBox>

                    <VBox fx:id="signUpEmailSection" spacing="10">
                        <Label fx:id="signUpEmailText" text="Email">
                            <VBox.margin>
                                <Insets top="10"/>
                            </VBox.margin>
                        </Label>

                        <TextField fx:id="signUpEmailField" promptText="Enter your email address" prefWidth="80" style="-fx-background-color: rgba(44, 189, 57, 0.1);">
                            <padding>
                                <Insets left="7" top="10" bottom="10"/>
                            </padding>
                        </TextField>

                    </VBox>

                    <VBox fx:id="signUpPasswordSection" spacing="10">
                        <Label fx:id="signUpPasswordText" text="Password">
                            <VBox.margin>
                                <Insets top="10"/>
                            </VBox.margin>
                        </Label>

                        <PasswordField fx:id="signUpPasswordField" promptText="Enter your desired password" prefWidth="80" style="-fx-background-color: rgba(44, 189, 57, 0.1);">
                            <padding>
                                <Insets left="7" top="10" bottom="10"/>
                            </padding>
                        </PasswordField>
                    </VBox>

                    <VBox fx:id="signUpPhoneSection" spacing="10">
                        <Label fx:id="signUpPhoneText" text="Phone">
                            <VBox.margin>
                                <Insets top="10"/>
                            </VBox.margin>
                        </Label>

                        <CustomNumberField fx:id="signUpPhoneField"  promptText="Enter your phone number" prefWidth="80" style="-fx-background-color: rgba(44, 189, 57, 0.1);">
                            <padding>
                                <Insets left="7" top="10" bottom="10"/>
                            </padding>
                        </CustomNumberField>
                    </VBox>

                    <Button fx:id="signUpProceedButton" text="Proceed" textFill="#FFFFFF" prefWidth="400" style="-fx-background-color: #12AF20; -fx-border-radius: 10;">
                        <VBox.margin>
                            <Insets top="30"/>
                        </VBox.margin>
                        <padding>
                            <Insets top="10" bottom="10"/>
                        </padding>
                    </Button>

                    <VBox alignment="CENTER" spacing="10">
                        <Label fx:id="signUpContinueText" text="or continue using">
                            <VBox.margin>
                                <Insets top="30" bottom="20"/>
                            </VBox.margin>
                        </Label>

                        <Button fx:id="signUpGoogleButton" prefWidth="300" text="Sign in with Google" textFill="#034801" style="-fx-border-color: #12AF20; -fx-border-radius: 5;">
                            <padding>
                                <Insets  top="15" bottom="15"/>
                            </padding>
                        </Button>

                        <!--<Button fx:id="signUpFacebookButton" prefWidth="300" text="Sign in with Facebook" textFill="#034801" style="-fx-border-color: #12AF20; -fx-border-radius: 5;">
                            <padding>
                                <Insets top="15" bottom="15"/>
                            </padding>
                        </Button>-->

                        <HBox alignment="CENTER" spacing="5">
                            <Label fx:id="signUpHaveAccountText" text="Already have an account?"/>
                            <Label fx:id="signUpLoginText" text="Login" textFill="#12AF20"/>

                            <VBox.margin>
                                <Insets top="10"/>
                            </VBox.margin>
                        </HBox>
                    </VBox>

                    <padding>
                        <Insets top="30" right="30" bottom="30"/>
                    </padding>
                </VBox>

                <VBox fx:id="loginSection" prefWidth="500" prefHeight="200" alignment="TOP_CENTER" visible="false">
                    <VBox spacing="10">
                        <VBox fx:id="loginEmailSection" spacing="10">
                            <Label fx:id="loginHeaderText" text="Login" textFill="#034801"/>
                            <Label fx:id="loginEmailText" text="Email">
                                <VBox.margin>
                                    <Insets top="30"/>
                                </VBox.margin>
                            </Label>

                            <TextField fx:id="loginEmailField" promptText="Enter your email address" prefWidth="80" style="-fx-background-color: rgba(44, 189, 57, 0.1);">
                                <padding>
                                    <Insets left="7" top="10" bottom="10"/>
                                </padding>
                            </TextField>
                        </VBox>

                        <VBox fx:id="loginPasswordSection" spacing="10">
                            <Label fx:id="loginPasswordText" text="Password">
                                <VBox.margin>
                                    <Insets top="10"/>
                                </VBox.margin>
                            </Label>

                            <PasswordField fx:id="loginPasswordField" promptText="Enter your desired password" prefWidth="80" style="-fx-background-color: rgba(44, 189, 57, 0.1);">
                                <padding>
                                    <Insets left="7" top="10" bottom="10"/>
                                </padding>
                            </PasswordField>
                        </VBox>
                    </VBox>

                    <Button fx:id="loginProceedButton" text="Proceed" textFill="#FFFFFF" prefWidth="400" style="-fx-background-color: #12AF20; -fx-border-radius: 10;">
                        <VBox.margin>
                            <Insets top="30"/>
                        </VBox.margin>
                        <padding>
                            <Insets top="10" bottom="10"/>
                        </padding>
                    </Button>

                    <VBox alignment="CENTER" spacing="10">
                        <Label fx:id="loginContinueText" text="or continue using" >
                            <VBox.margin>
                                <Insets top="30" bottom="20"/>
                            </VBox.margin>
                        </Label>

                        <Button fx:id="loginGoogleButton" prefWidth="300" alignment="CENTER" text="Sign in with Google" textFill="#034801" style="-fx-border-color: #12AF20; -fx-border-radius: 5;">
                            <padding>
                                <Insets  top="15" bottom="15"/>
                            </padding>
                        </Button>

                        <!--<Button fx:id="loginFacebookButton" prefWidth="300" text="Sign in with Facebook" textFill="#034801" style="-fx-border-color: #12AF20; -fx-border-radius: 5;">
                            <padding>
                                <Insets top="15" bottom="15"/>
                            </padding>
                        </Button>-->

                        <HBox alignment="CENTER" spacing="5">
                            <Label fx:id="forgotPasswordText" text="Forgot Password?"/>
                            <Label fx:id="resetPasswordText" text="Reset Password" textFill="#12AF20"/>

                            <VBox.margin>
                                <Insets top="15"/>
                            </VBox.margin>
                        </HBox>

                        <HBox alignment="CENTER" spacing="5">
                            <Label fx:id="loginHaveAcctText" text="Don't have an account?"/>
                            <Label fx:id="loginSignUpText" text="Sign up" textFill="#12AF20"/>

                            <HBox.margin>
                                <Insets top="5"/>
                            </HBox.margin>
                        </HBox>
                    </VBox>

                    <padding>
                        <Insets top="30" right="30" bottom="30"/>
                    </padding>
                </VBox>

                <VBox fx:id="recoverPasswordSection" spacing="10" visible="false">
                    <Label fx:id="recoverHeaderText" text="Reset Password" textFill="#034801"/>
                    <Label fx:id="recoverEmailText" text="Email">
                        <VBox.margin>
                            <Insets top="30"/>
                        </VBox.margin>
                    </Label>

                    <TextField fx:id="recoverEmailField" promptText="Enter your email address" prefWidth="80" style="-fx-background-color: rgba(44, 189, 57, 0.1);">
                        <padding>
                            <Insets left="7" top="10" bottom="10"/>
                        </padding>
                    </TextField>
                    <Label fx:id="recoverEmailPrompt" text="Please enter a valid email address" textFill="#FF0000" visible="false" wrapText="true"/>

                    <HBox alignment="CENTER">
                        <Button fx:id="recoverProceedButton" text="Proceed" textFill="#FFFFFF" prefWidth="400" style="-fx-background-color: #12AF20; -fx-border-radius: 10;">
                            <padding>
                                <Insets top="10" bottom="10"/>
                            </padding>
                        </Button>
                        <VBox.margin>
                            <Insets top="10"/>
                        </VBox.margin>
                    </HBox>
                    <HBox alignment="CENTER">
                        <Label fx:id="recoverLoginText" text="Back to Login" textFill="#12AF20" alignment="CENTER"/>
                        <VBox.margin>
                            <Insets top="10"/>
                        </VBox.margin>
                    </HBox>

                    <padding>
                        <Insets topRightBottomLeft="30"/>
                    </padding>
                </VBox>

            </StackPane>
        </right>
    </BorderPane>

    <VBox fx:id="dimmer" opacity="0.5" style="-fx-background-color: #000000;" visible="false"
          AnchorPane.topAnchor="1" AnchorPane.rightAnchor="1" AnchorPane.bottomAnchor="1" AnchorPane.leftAnchor="1"/>
    <ProgressIndicator fx:id="progressBar" maxWidth="150" maxHeight="50" StackPane.alignment="CENTER" visible="false"/>

</AnchorPane>
