<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import org.kordamp.bootstrapfx.scene.layout.Panel?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<fx:root type="javafx.scene.control.ListCell" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" style="-fx-background-color: #F1F1F1;">

    <graphic>
        <Panel>
            <left>
                <HBox spacing="10" alignment="CENTER">
                    <ImageView fx:id="playerImage" fitHeight="40" fitWidth="40"/>
                    <Label fx:id="participantName" text="Uche Umeh" textFill="#053500" alignment="TOP_CENTER"/>
                </HBox>
            </left>
            <right>
                <HBox alignment="CENTER">
                    <Label fx:id="numOfPoints" text="500 pts" textFill="#12AF20"/>
                </HBox>
            </right>
            <padding>
                <Insets top="5" bottom="5" left="20" right="20"/>
            </padding>
        </Panel>
    </graphic>

</fx:root>
