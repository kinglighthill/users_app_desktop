<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="800.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.scholarly.utme.controller.SelectNoteController">
    <top>
        <ToolBar prefHeight="75.0" prefWidth="1000.0" style="-fx-background-color: #105801;" BorderPane.alignment="CENTER">
            <items>
                <Button fx:id="backButton" mnemonicParsing="false" onMouseClicked="#backButtonClicked"/>
                <Label fx:id="pageTitle" text="Select Note" textFill="WHITE">
                    <padding>
                        <Insets left="20.0" />
                    </padding>
                    <font>
                        <Font size="24.0" />
                    </font>
                </Label>
            </items>
            <padding>
                <Insets left="10.0" />
            </padding>
        </ToolBar>
    </top>
    <center>
        <StackPane prefHeight="200.0" prefWidth="100.0">
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: #EDEDED;">
               <children>
                  <VBox prefHeight="716.0" prefWidth="344.0" style="-fx-background-color: #EDEDED;">
                     <children>
                        <Label fx:id="subjectsTitle" prefHeight="17.0" prefWidth="361.0" style="-fx-background-color: #ffffff;" text="Subjects" textFill="#105801">
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                           <padding>
                              <Insets bottom="20.0" left="20.0" top="20.0" />
                           </padding>
                        </Label>
                        <Region prefHeight="5.0" prefWidth="200.0" />
                        <ScrollPane fx:id="subjectListScrollPane" fitToWidth="true" hbarPolicy="NEVER" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: #ffffff; -fx-border-color: #EDEDED;" VBox.vgrow="ALWAYS">
                           <content>
                              <VBox fx:id="subjectListVBox" prefHeight="200.0" prefWidth="100.0" spacing="5.0" style="-fx-background-color: #F7F7F7;" />
                           </content>
                        </ScrollPane>
                     </children>
                  </VBox>
                  <Region prefHeight="200.0" prefWidth="5.0" />
                  <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                      <children>
                          <Label fx:id="topicsTitle" prefHeight="57.0" prefWidth="2000.0" style="-fx-background-color: #ffffff;" text="Topics" textFill="#105801">
                              <VBox.margin>
                                  <Insets />
                              </VBox.margin>
                              <padding>
                                  <Insets bottom="20.0" left="20.0" top="20.0" />
                              </padding>
                          </Label>
                          <Line endX="200.0" fill="BLACK" startX="-100.0" stroke="#ebebeb00" strokeWidth="5.0">
                              <VBox.margin>
                                  <Insets />
                              </VBox.margin>
                          </Line>
                        <StackPane fx:id="topicStackPane" prefHeight="150.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                           <children>
                              <ScrollPane fx:id="topicListScrollPane" fitToWidth="true" prefHeight="200.0" prefWidth="200.0">
                                 <content>
                                    <VBox fx:id="topicListVBox" prefHeight="200.0" prefWidth="100.0" spacing="5.0" style="-fx-background-color: #F7F7F7;" />
                                 </content>
                              </ScrollPane>
                              <Label fx:id="emptyTopicListLabel" text="Select a Subject" />
                           </children>
                        </StackPane>
                      </children>
                  </VBox>
               </children>
            </HBox>
            <Button fx:id="commenceButton" mnemonicParsing="false" style="-fx-background-color: #4BB036; -fx-background-radius: 5;" text="Commence Study" textFill="WHITE" visible="false" StackPane.alignment="BOTTOM_RIGHT">
               <StackPane.margin>
                  <Insets bottom="30.0" right="30.0" />
               </StackPane.margin>
               <padding>
                  <Insets bottom="15.0" left="30.0" right="30.0" top="15.0" />
               </padding>
            </Button>
         </children></StackPane>
    </center>
</BorderPane>
