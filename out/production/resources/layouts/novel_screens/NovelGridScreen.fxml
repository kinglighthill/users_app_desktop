<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import org.controlsfx.control.cell.ImageGridCell?>
<?import org.controlsfx.control.GridView?>
<?import org.kordamp.bootstrapfx.scene.layout.Panel?>
<?import javafx.scene.image.ImageView?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.scholarly.utme.controller.novel_screens.NovelGridScreenController"
            maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;">

    <top>
        <Panel>
            <left>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Button fx:id="backButton" style="-fx-background-color: #E7F7E9"/>
                    <Label fx:id="pageTitle" textFill="#034801">
                        <font>
                            <Font name="System Bold" size="20"/>
                        </font>
                    </Label>
                    <padding>
                        <Insets top="20" left="20" bottom="20"/>
                    </padding>
                </HBox>
            </left>
        </Panel>
    </top>

    <center>
        <VBox BorderPane.alignment="TOP_LEFT" spacing="20" >
            <StackPane maxWidth="250">
                <TextField promptText="Enter a keyword" prefWidth="50" prefHeight="30" style="-fx-background-color: rgba(0, 107, 23, 0.05); -fx-background-radius: 8; -fx-border-color: #12AF20; -fx-border-radius: 8;"/>
                <ImageView fx:id="searchIcon" preserveRatio="true" pickOnBounds="true" StackPane.alignment="CENTER_RIGHT">
                    <StackPane.margin>
                        <Insets right="15"/>
                    </StackPane.margin>
                </ImageView>
                <VBox.margin>
                    <Insets left="17"/>
                </VBox.margin>
            </StackPane>

            <GridView fx:id="novelGridView" horizontalCellSpacing="30" verticalCellSpacing="30" cellWidth="100" cellHeight="200"/>
            <padding>
                <Insets top="20" right="20" bottom="20" left="10"/>
            </padding>
        </VBox>
    </center>

</BorderPane>
