<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Font?>
<AnchorPane maxWidth="1.7976931348623157E308" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.scholarly.utme.controller.audio_video_screens.AudioVideoSubjectListItemController">

    <children>
        <VBox fx:id="subRoot" prefWidth="600.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-border-color: #e5e5e5; -fx-border-width: 1; -fx-border-radius: 8;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <BorderPane  minHeight="-Infinity" minWidth="-Infinity" prefHeight="100.0" prefWidth="490.0">

                    <left>
                        <StackPane fx:id="subjectImageBackground" minWidth="100" >
                            <ImageView fx:id="subjectImage" preserveRatio="true" pickOnBounds="true">
                                <HBox.margin>
                                    <Insets left="20"/>
                                </HBox.margin>
                            </ImageView>
                            <padding>
                                <Insets left="30" right="30"/>
                            </padding>
                        </StackPane>
                    </left>
                    <center>
                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="subjectText" textFill="#034801" >
                                <font>
                                    <Font name="Gill Sans MT Bold" size="18.0" />
                                </font>
                                <HBox.margin>
                                    <Insets left="250"/>
                                </HBox.margin>
                            </Label>
                        </HBox>

                    </center>
                    <right>
                        <CheckBox fx:id="subjectCheckBox" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="17.0" prefWidth="40.0"  HBox.hgrow="ALWAYS">
                            <font>
                                <Font size="18"/>
                            </font>
                        </CheckBox>

                    </right>
                    <padding>
                        <Insets right="30"/>
                    </padding>

                </BorderPane>
                <Separator fx:id="divider" opacity="0.5" prefWidth="200.0" />
                <HBox fx:id="optionPanel" prefWidth="200.0" prefHeight="80">
                    <children>
                        <VBox spacing="20">
                            <children>
                                <Label text="Topics">
                                    <font>
                                        <Font name="Gill Sans MT" size="15"/>
                                    </font>
                                </Label>
                                <Label text="Sub topics">
                                    <font>
                                        <Font name="Gill Sans MT" size="15"/>
                                    </font>
                                </Label>
                            </children>
                            <HBox.margin>
                                <Insets top="8.0"/>
                            </HBox.margin>
                        </VBox>
                        <VBox>
                            <children>
                                <ChoiceBox fx:id="topicsChoiceBox" prefHeight="25" prefWidth="200.0"  style="-fx-background-color: #FFFFFF; -fx-border-color: #12AF20; -fx-border-radius: 5;">
                                    <VBox.margin>
                                        <Insets top="8.0" />
                                    </VBox.margin>
                                </ChoiceBox>

                                <ChoiceBox fx:id="subtopicsChoiceBox" prefHeight="25" prefWidth="200.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #12AF20; -fx-border-radius: 5;">
                                    <VBox.margin>
                                        <Insets top="8.0" />
                                    </VBox.margin>
                                </ChoiceBox>

                            </children>
                            <HBox.margin>
                                <Insets left="40.0" />
                            </HBox.margin>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets left="20.0" right="10.0" top="15.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="1.5" top="1.5" />
    </padding>

</AnchorPane>
