<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import org.controlsfx.control.GridView?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.scholarly.utme.controller.trivia_screens.TriviaRankingScreenController"
            prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;">

    <top>
        <VBox prefHeight="60.0" prefWidth="600.0" BorderPane.alignment="CENTER" style="-fx-background-color: white;">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="120.0" prefWidth="200.0">
                    <children>
                        <Button fx:id="backButton" maxHeight="30" maxWidth="30"/>
                        <Label text="Trivia Ranking">
                            <font>
                                <Font name="Gill Sans MT Bold" size="18.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets left="20.0" />
                    </padding>
                </HBox>
            </children>
            <Separator/>
        </VBox>
    </top>

    <center>
        <HBox alignment="CENTER" prefWidth="700" prefHeight="800">
            <ListView fx:id="rankingsList" prefHeight="600"  prefWidth="500" >
                <padding>
                    <Insets top="20" bottom="20"/>
                </padding>
            </ListView>
            <Separator/>
        </HBox>
    </center>

    <right>
        <AnchorPane prefWidth="500" prefHeight="400" style="-fx-background-color: white;">
            <children>
                <GridView fx:id="rankingGrid" prefHeight="500" prefWidth="500" cellHeight="500" horizontalCellSpacing="25" style="-fx-background-color: #F1F1F1; -fx-background-radius: 5;"
                                               AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.bottomAnchor="20">
                    <padding>
                        <Insets left="30"/>
                    </padding>
                </GridView>

            </children>
        </AnchorPane>
    </right>

</BorderPane>
